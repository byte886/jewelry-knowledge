# ============================================================
# 宝石学家老许知识库 · 项目仓库 .gitignore
# 原则：只版本管理「代码 + 文档 + 台账 + 转写/OKF 文本」
#       原始媒体、凭证、虚拟环境、过程垃圾一律不入库
# ============================================================

# ---- 大体积原始媒体（13G，本地留存，不进 git；元数据已在 00_manifest）----
library/01_video/
library/02_audio/
*.mp4
*.mkv
*.webm
*.m4a
*.mp3
*.wav
*.opus

# （06_articles 整体作为原料不入库，规则见文末 ADR-012 成品门禁）

# ---- 凭证 / 浏览器登录态 / cookie（敏感，绝不入库；公有仓连加密 .enc 也不放，只留本地）----
secrets/
.secrets/
*.netscape.txt
cookies*.txt
.chrome-prof/
.chrome-prof2/
.chrome-prof3/
.chrome-prof*/
.venv-cf/
.venv/
venv/

# ---- 日志 / 进程 / 抓取临时 / 运行时工作区（过程件统一收口，不入库不传网盘）----
*.log
*.pid
*.har
rss_*.xml
_archive/
workspace/

# ---- 与本项目无关的截图（豆包额度等）----
shot7days*.png
sub.png
sub_conv.png
upshot.png
upshot-view.png

# ---- 系统 / 编辑器 / Python 缓存 ----
.DS_Store
__pycache__/
*.pyc
*.pyo
.idea/
.vscode/

# ---- Vision OCR 编译产物（由 ocr_vision.swift 现场编译，只入库源码）----
scripts/ocr/ocr_vision

# ============================================================
# 公有仓成品门禁（ADR-012）：原料/逐字稿/采集原文不入库，只留本地
# 逐字 draft 精修为 stable 后，需在下方显式放行并 git add 该文件
# ============================================================
# 逐字转写、图文原文/OCR：原料，整体不入库
library/04_transcript/
library/06_articles/
# 外部来源 08_sources：只入库 SOURCE.md / manifest.json，raw、cleaned 不入库
library/08_sources/**/raw/
library/08_sources/**/cleaned/
# VideoNote 成品门禁：默认忽略全部 md，仅放行分类 index 与 stable 成品
